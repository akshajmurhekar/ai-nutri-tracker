# Copy this file to .env.local and fill in real values.
# All of these except NEXT_PUBLIC_* are server-only (kept out of the browser bundle).

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon (publishable) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google Gemini API key (server-only, never expose to the browser)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
